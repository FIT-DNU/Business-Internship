<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_quan_ly_du_an_tree" model="ir.ui.view">
        <field name="name">quan_ly.du_an.tree</field>
        <field name="model">quan_ly.du_an</field>
        <field name="arch" type="xml">
            <tree decoration-danger="muc_do_uu_tien_logic == '3'" 
                  decoration-warning="muc_do_uu_tien_logic == '2'"
                  decoration-info="is_high_value == True">
                <field name="name"/>
                <field name="manager_id"/>
                <field name="ngan_sach"/>
                <field name="ngay_ket_thuc"/>
                <field name="tien_do_tong_the" widget="progressbar"/>
                <field name="muc_do_uu_tien_logic" widget="priority"/>
                <field name="is_high_value" invisible="1"/>
            </tree>
        </field>
    </record>

    <record id="view_quan_ly_du_an_form" model="ir.ui.view">
        <field name="name">quan_ly.du_an.form</field>
        <field name="model">quan_ly.du_an</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="KHẨN CẤP" bg_color="bg-danger" 
                            attrs="{'invisible': [('is_urgent', '=', False)]}"/>
                    <widget name="web_ribbon" title="DỰ ÁN LỚN" bg_color="bg-warning" 
                            attrs="{'invisible': [('is_high_value', '=', False)]}"/>
                    
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Tên dự án..."/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="manager_id"/>
                            <field name="ngan_sach"/>
                            <field name="is_urgent" invisible="1"/>
                            <field name="is_high_value" invisible="1"/>
                        </group>
                        <group>
                            <field name="ngay_bat_dau"/>
                            <field name="ngay_ket_thuc"/>
                            <field name="muc_do_uu_tien_logic" widget="priority"/>
                        </group>
                    </group>
                    <group string="Tiến độ tổng thể">
                        <field name="tien_do_tong_the" widget="progressbar"/>
                    </group>
                    <notebook>
                        <page string="Danh sách công việc">
                            <field name="task_ids">
                                <tree editable="bottom" decoration-danger="is_overdue == True">
                                    <field name="name"/>
                                    <field name="nguoi_thuc_hien_id"/>
                                    <field name="deadline"/>
                                    <field name="is_overdue" invisible="1"/>
                                    <field name="tien_do" widget="progressbar"/>
                                    <field name="trang_thai" widget="badge" 
                                           decoration-success="trang_thai == 'xong'" 
                                           decoration-info="trang_thai == 'dang_lam'"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_du_an_graph" model="ir.ui.view">
        <field name="name">quan_ly.du_an.graph</field>
        <field name="model">quan_ly.du_an</field>
        <field name="arch" type="xml">
            <graph string="Phân tích Ngân sách" type="bar">
                <field name="name"/>
                <field name="ngan_sach" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_du_an_pivot" model="ir.ui.view">
        <field name="name">quan_ly.du_an.pivot</field>
        <field name="model">quan_ly.du_an</field>
        <field name="arch" type="xml">
            <pivot string="Thống kê dự án">
                <field name="manager_id" type="row"/>
                <field name="tien_do_tong_the" type="measure"/>
                <field name="ngan_sach" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_quan_ly_du_an" model="ir.actions.act_window">
        <field name="name">Dự án</field>
        <field name="res_model">quan_ly.du_an</field>
        <field name="view_mode">tree,form,graph,pivot</field>
    </record>
</odoo>