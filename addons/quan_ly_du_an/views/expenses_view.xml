<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_expenses_tree" model="ir.ui.view">
        <field name="name">expenses.tree</field>
        <field name="model">expenses</field>
        <field name="arch" type="xml">
            <tree string="Chi phí">
                <field name="expenses_name"/>
                <field name="du_an_id"/>
                <field name="cong_viec_id"/>
                <field name="budgets_id"/>
                <field name="amount"/>
                <field name="date"/>
            </tree>
        </field>
    </record>

    <record id="view_expenses_form" model="ir.ui.view">
        <field name="name">expenses.form</field>
        <field name="model">expenses</field>
        <field name="arch" type="xml">
            <form string="Chi phí">
                <sheet>
                    <group>
                        <field name="expenses_name"/>
                        <field name="du_an_id" readonly="1"/>
                        <field name="cong_viec_id"/>
                        <field name="budgets_id"/>
                        <field name="amount"/>
                        <field name="date"/>
                    </group>
                    <group>
                        <field name="ly_do_vuot_ngan_sach"/>
                        <field name="mo_ta"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_expenses" model="ir.actions.act_window">
        <field name="name">Chi Phí</field>
        <field name="res_model">expenses</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
