<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ===================== KANBAN VIEW ===================== -->
    <record id="view_nhan_vien_kanban" model="ir.ui.view">
        <field name="name">view.nhan.vien.kanban</field>
        <field name="model">nhan_vien</field>
        <field name="arch" type="xml">
            <kanban string="Nhân viên" class="o_kanban_small_column">
                <field name="id"/>
                <field name="image"/>
                <field name="ma_dinh_danh"/>
                <field name="ho_va_ten"/>
                <field name="email"/>
                <field name="gioi_tinh"/>
                <field name="so_dien_thoai"/>
                <field name="chuc_vu_id"/>
                <field name="phong_ban_id"/>
                <field name="nhom_du_an_ids"/>

                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click o_kanban_card">
                            <div class="d-flex">
                                <div class="o_kanban_image mr8">
                                    <img t-att-src="kanban_image('nhan_vien', 'image', record.id.raw_value)"
                                         alt="Ảnh nhân viên"
                                         style="width: 64px; height: 64px; object-fit: cover; border-radius: 50%;"/>
                                </div>

                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="ho_va_ten"/>
                                    </strong>
                                    <div class="text-muted">
                                        <field name="ma_dinh_danh"/>
                                    </div>

                                    <div class="mt4" t-if="record.chuc_vu_id.raw_value">
                                        <span class="badge badge-pill badge-primary">
                                            <field name="chuc_vu_id"/>
                                        </span>
                                    </div>

                                    <div class="mt4" t-if="record.phong_ban_id.raw_value">
                                        <i class="fa fa-building mr-1" title="Phòng ban"/>
                                        <field name="phong_ban_id"/>
                                    </div>
                                </div>
                            </div>

                            <div class="o_kanban_record_body mt8">
                                <div t-if="record.email.raw_value">
                                    <i class="fa fa-envelope mr-1" title="Email"/>
                                    <field name="email"/>
                                </div>

                                <div t-if="record.so_dien_thoai.raw_value">
                                    <i class="fa fa-phone mr-1" title="Số điện thoại"/>
                                    <field name="so_dien_thoai"/>
                                </div>

                                <div class="mt8" t-if="record.nhom_du_an_ids.raw_value">
                                    <i class="fa fa-users mr-1" title="Nhóm dự án"/>
                                    <field name="nhom_du_an_ids" widget="many2many_tags"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>


    <!-- ===================== TREE VIEW ===================== -->
    <record id="view_nhan_vien_tree" model="ir.ui.view">
        <field name="name">view.nhan.vien.tree</field>
        <field name="model">nhan_vien</field>
        <field name="arch" type="xml">
            <tree string="Danh sách nhân viên">
                <field name="ma_dinh_danh"/>
                <field name="ho_va_ten"/>
                <field name="chuc_vu_id"/>
                <field name="phong_ban_id"/>
                <field name="email"/>
                <field name="so_dien_thoai"/>
                <field name="gioi_tinh"/>
                <field name="ngay_sinh"/>
            </tree>
        </field>
    </record>


    <!-- ===================== FORM VIEW ===================== -->
    <record id="view_nhan_vien_form" model="ir.ui.view">
        <field name="name">view.nhan.vien.form</field>
        <field name="model">nhan_vien</field>
        <field name="arch" type="xml">
            <form string="Thông tin nhân viên">
                <sheet>
                    <div class="d-flex align-items-start">
                        <div class="mr16">
                            <field name="image" widget="image" class="oe_avatar"/>
                        </div>

                        <div class="oe_title">
                            <label for="ho_va_ten" string="Nhân viên"/>
                            <h1>
                                <field name="ho_va_ten" readonly="1"/>
                            </h1>
                            <h3 class="text-muted">
                                <field name="ma_dinh_danh" placeholder="Mã định danh"/>
                            </h3>
                        </div>
                    </div>

                    <group>
                        <group string="Thông tin cá nhân">
                            <field name="ho_ten_dem"/>
                            <field name="ten"/>
                            <field name="ngay_sinh"/>
                            <field name="gioi_tinh"/>
                            <field name="que_quan"/>
                        </group>

                        <group string="Liên hệ và tổ chức">
                            <field name="email" widget="email"/>
                            <field name="so_dien_thoai" widget="phone"/>
                            <field name="chuc_vu_id"/>
                            <field name="phong_ban_id"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Lịch sử làm việc">
                            <field name="lich_su_lam_viec_ids">
                                <tree>
                                    <field name="ten_cong_viec"/>
                                    <field name="chuc_vu_id"/>
                                    <field name="phong_ban_id"/>
                                    <field name="ngay_bat_dau"/>
                                    <field name="ngay_ket_thuc"/>
                                </tree>
                            </field>
                        </page>

                        <page string="Nhóm Dự Án">
                            <field name="nhom_du_an_ids" widget="many2many_tags"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>


    <!-- ===================== GRAPH VIEW ===================== -->
    <record id="view_nhan_vien_graph" model="ir.ui.view">
        <field name="name">view.nhan.vien.graph</field>
        <field name="model">nhan_vien</field>
        <field name="arch" type="xml">
            <graph string="Thống kê nhân viên" type="bar">
                <field name="phong_ban_id"/>
                <field name="chuc_vu_id"/>
            </graph>
        </field>
    </record>


    <!-- ===================== PIVOT VIEW ===================== -->
    <record id="view_nhan_vien_pivot" model="ir.ui.view">
        <field name="name">view.nhan.vien.pivot</field>
        <field name="model">nhan_vien</field>
        <field name="arch" type="xml">
            <pivot string="Phân tích nhân sự">
                <field name="phong_ban_id" type="row"/>
                <field name="chuc_vu_id" type="col"/>
            </pivot>
        </field>
    </record>


    <!-- ===================== SEARCH VIEW ===================== -->
    <record id="view_nhan_vien_search" model="ir.ui.view">
        <field name="name">view.nhan.vien.search</field>
        <field name="model">nhan_vien</field>
        <field name="arch" type="xml">
            <search string="Tìm kiếm nhân viên">
                <field name="ma_dinh_danh"/>
                <field name="ho_va_ten"/>
                <field name="email"/>
                <field name="so_dien_thoai"/>
                <field name="chuc_vu_id"/>
                <field name="phong_ban_id"/>
                <field name="nhom_du_an_ids"/>

                <separator/>

                <filter string="Nam"
                        name="nam"
                        domain="[('gioi_tinh', '=', 'nam')]"/>

                <filter string="Nữ"
                        name="nu"
                        domain="[('gioi_tinh', '=', 'nu')]"/>

                <separator/>

                <filter string="Nhóm theo phòng ban"
                        name="group_phong_ban"
                        context="{'group_by': 'phong_ban_id'}"/>

                <filter string="Nhóm theo chức vụ"
                        name="group_chuc_vu"
                        context="{'group_by': 'chuc_vu_id'}"/>

                <filter string="Nhóm theo giới tính"
                        name="group_gioi_tinh"
                        context="{'group_by': 'gioi_tinh'}"/>

                <searchpanel>
                    <field name="chuc_vu_id" select="multi"/>
                    <field name="phong_ban_id" select="multi"/>
                    <field name="nhom_du_an_ids" select="multi"/>
                </searchpanel>
            </search>
        </field>
    </record>


    <!-- ===================== ACTION NHÂN VIÊN ===================== -->
    <record id="action_nhan_vien" model="ir.actions.act_window">
        <field name="name">Nhân Viên</field>
        <field name="res_model">nhan_vien</field>
        <field name="view_mode">kanban,tree,form,graph,pivot</field>
        <field name="search_view_id" ref="view_nhan_vien_search"/>
        <field name="context">{'search_default_group_phong_ban': 1}</field>
    </record>


    <!-- ===================== ACTION TỔNG QUAN NHÂN SỰ ===================== -->
    <record id="action_nhan_su_tong_quan" model="ir.actions.act_window">
        <field name="name">Tổng Quan Nhân Sự</field>
        <field name="res_model">nhan_vien</field>
        <field name="view_mode">graph,pivot,kanban,tree,form</field>
        <field name="search_view_id" ref="view_nhan_vien_search"/>
        <field name="context">{'search_default_group_phong_ban': 1}</field>
    </record>

</odoo>
