<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_lich_su_lam_viec_tree" model="ir.ui.view">
        <field name="name">view.lich.su.lam.viec.tree</field>
        <field name="model">lich_su_lam_viec</field>
        <field name="arch" type="xml">
            <tree string="Lịch sử làm việc">
                <field name="nhan_vien_id"/>
                <field name="ten_cong_viec"/>
                <field name="chuc_vu_id"/>
                <field name="phong_ban_id"/>
                <field name="ngay_bat_dau"/>
                <field name="ngay_ket_thuc"/>
            </tree>
        </field>
    </record>

    <record id="view_lich_su_lam_viec_form" model="ir.ui.view">
        <field name="name">view.lich.su.lam.viec.form</field>
        <field name="model">lich_su_lam_viec</field>
        <field name="arch" type="xml">
            <form string="Lịch sử làm việc">
                <sheet>
                    <group>
                        <field name="nhan_vien_id"/>
                        <field name="ten_cong_viec"/>
                        <field name="chuc_vu_id" readonly="1"/>
                        <field name="phong_ban_id" readonly="1"/>
                        <field name="ngay_bat_dau"/>
                        <field name="ngay_ket_thuc"/>
                        <field name="mo_ta"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_lich_su_lam_viec" model="ir.actions.act_window">
        <field name="name">Lịch Sử Làm Việc</field>
        <field name="res_model">lich_su_lam_viec</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>





