<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_thong_bao_noi_bo_tree" model="ir.ui.view">
        <field name="name">thong_bao_noi_bo.tree</field>
        <field name="model">thong_bao_noi_bo</field>
        <field name="arch" type="xml">
            <tree string="Thông Báo Nội Bộ" decoration-muted="trang_thai == 'read'">
                <field name="create_date"/>
                <field name="name"/>
                <field name="nhan_vien_id"/>
                <field name="loai"/>
                <field name="trang_thai"/>
                <field name="du_an_id"/>
                <field name="cong_viec_id"/>
            </tree>
        </field>
    </record>

    <record id="view_thong_bao_noi_bo_form" model="ir.ui.view">
        <field name="name">thong_bao_noi_bo.form</field>
        <field name="model">thong_bao_noi_bo</field>
        <field name="arch" type="xml">
            <form string="Thông Báo Nội Bộ">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="nhan_vien_id"/>
                        <field name="loai"/>
                        <field name="trang_thai"/>
                    </group>
                    <group>
                        <field name="du_an_id"/>
                        <field name="cong_viec_id"/>
                    </group>
                    <group>
                        <field name="noi_dung"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_thong_bao_noi_bo" model="ir.actions.act_window">
        <field name="name">Thông Báo Nội Bộ</field>
        <field name="res_model">thong_bao_noi_bo</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_thong_bao_noi_bo_search"/>
        <field name="context">{'search_default_filter_unread': 1}</field>
    </record>

    <!-- ===================== SEARCH VIEW ===================== -->
    <record id="view_thong_bao_noi_bo_search" model="ir.ui.view">
        <field name="name">thong_bao_noi_bo.search</field>
        <field name="model">thong_bao_noi_bo</field>
        <field name="arch" type="xml">
            <search string="Tìm kiếm thông báo">
                <field name="name"/>
                <field name="nhan_vien_id"/>
                <field name="loai"/>
                <field name="trang_thai"/>
                <field name="du_an_id"/>
                <field name="cong_viec_id"/>

                <separator/>

                <filter string="Chưa đọc"
                        name="filter_unread"
                        domain="[('trang_thai', '!=', 'read')]"/>

                <filter string="Đã đọc"
                        name="filter_read"
                        domain="[('trang_thai', '=', 'read')]"/>

                <separator/>

                <filter string="Nhóm theo trạng thái"
                        name="group_trang_thai"
                        context="{'group_by': 'trang_thai'}"/>

                <filter string="Nhóm theo loại"
                        name="group_loai"
                        context="{'group_by': 'loai'}"/>

                <filter string="Nhóm theo nhân viên"
                        name="group_nhan_vien"
                        context="{'group_by': 'nhan_vien_id'}"/>
            </search>
        </field>
    </record>

</odoo>
